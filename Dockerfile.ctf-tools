# A local, independently versioned toolbox. Pwn and RE Python dependencies are
# separated: pwntools 4.15 excludes Unicorn 2.1.4, while angr's extra uses it.
FROM golang:1.26
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    binutils build-essential ca-certificates checksec curl file gdb gdbserver \
    libc6-i386 libc6-dev-i386 libffi-dev libssl-dev ltrace netcat-openbsd patchelf \
    python3 python3-venv python3-dev ruby ruby-dev strace unzip xxd openjdk-21-jdk-headless \
    qemu-user socat && rm -rf /var/lib/apt/lists/*
COPY docker/ctf-tools/pwn-requirements.txt docker/ctf-tools/re-requirements.txt /opt/ctf/
RUN python3 -m venv /opt/ctf/pwn && /opt/ctf/pwn/bin/pip install --no-cache-dir -r /opt/ctf/pwn-requirements.txt \
    && python3 -m venv /opt/ctf/re && /opt/ctf/re/bin/pip install --no-cache-dir -r /opt/ctf/re-requirements.txt \
    && /opt/ctf/pwn/bin/pip check && /opt/ctf/re/bin/pip check \
    && /opt/ctf/pwn/bin/pip freeze > /opt/ctf/pwn-lock.txt \
    && /opt/ctf/re/bin/pip freeze > /opt/ctf/re-lock.txt \
    && printf '#!/bin/sh\nexec /opt/ctf/re/bin/python3 "$@"\n' > /usr/local/bin/ctf-python-re \
    && chmod +x /usr/local/bin/ctf-python-re \
    && gem install one_gadget -v 2.1.1 --no-document
RUN curl -fL --retry 3 -o /tmp/radare2.deb https://github.com/radareorg/radare2/releases/download/6.2.4/radare2_6.2.4_amd64.deb \
    && echo '7019eedc0e0e87d1f53d6b8f5fc62b898567679c5efdce7fbfc557c9e7655e90  /tmp/radare2.deb' | sha256sum -c - \
    && dpkg -i /tmp/radare2.deb && rm /tmp/radare2.deb \
    && curl -fL --retry 3 -o /usr/local/bin/pwninit https://github.com/io12/pwninit/releases/download/3.3.3/pwninit \
    && echo 'f124b6645b01b0fc4adacabe61438fe73eef517dc3e4696a08e1250a8f47eec3  /usr/local/bin/pwninit' | sha256sum -c - \
    && chmod +x /usr/local/bin/pwninit
RUN curl -fL --retry 3 -o /tmp/ghidra.zip https://github.com/NationalSecurityAgency/ghidra/releases/download/Ghidra_12.1.4_build/ghidra_12.1.4_PUBLIC_20260921.zip \
    && echo 'ddac49f903da9d5bac833e5cc79395098b9c33cfd3279be5f31bd00387d2d4db  /tmp/ghidra.zip' | sha256sum -c - \
    && unzip -q /tmp/ghidra.zip -d /opt/ctf && rm /tmp/ghidra.zip \
    && ln -s /opt/ctf/ghidra_12.1.4_PUBLIC/support/analyzeHeadless /usr/local/bin/analyzeHeadless
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends upx-ucl \
    && rm -rf /var/lib/apt/lists/*
COPY docker/ctf-tools/ExportFunctions.java /opt/ctf/scripts/ExportFunctions.java
COPY docker/ctf-tools/doctor.py /opt/ctf/doctor.py
# Crypto / Misc / Forensics 与 Pwn 补充工具。独立成最后几层，避免已有层缓存失效。
RUN (sed -i 's/deb.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list.d/debian.sources 2>/dev/null || true) \
    && apt-get -o Acquire::http::Timeout=300 -o Acquire::Retries=5 update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y -o Acquire::http::Timeout=300 -o Acquire::Retries=5 --no-install-recommends \
    binwalk exiftool foremost steghide tshark tcpdump xz-utils p7zip-full bsdmainutils bc jq \
    libseccomp-dev protobuf-compiler libprotobuf-c-dev && rm -rf /var/lib/apt/lists/*
COPY docker/ctf-tools/crypto-requirements.txt /opt/ctf/
RUN /opt/ctf/pwn/bin/pip install --no-cache-dir -i https://pypi.tuna.tsinghua.edu.cn/simple -r /opt/ctf/crypto-requirements.txt \
    && /opt/ctf/pwn/bin/pip check \
    && /opt/ctf/pwn/bin/pip freeze > /opt/ctf/pwn-lock.txt \
    && gem install seccomp-tools --no-document
COPY docker/ctf-tools/probe_target.py /opt/ctf/scripts/probe_target.py
COPY docker/ctf-tools/pcap_analyze.py /opt/ctf/scripts/pcap_analyze.py
COPY docker/ctf-tools/pwn_triage.py /opt/ctf/scripts/pwn_triage.py
COPY docker/ctf-tools/build_glibc_pool.py /tmp/build_glibc_pool.py
RUN chmod +x /opt/ctf/scripts/probe_target.py /opt/ctf/scripts/pcap_analyze.py /opt/ctf/scripts/pwn_triage.py \
    && ln -s /opt/ctf/scripts/probe_target.py /usr/local/bin/ctf-probe \
    && ln -s /opt/ctf/scripts/pcap_analyze.py /usr/local/bin/ctf-pcap \
    && ln -s /opt/ctf/scripts/pwn_triage.py /usr/local/bin/ctf-pwn-triage \
    && python3 /tmp/build_glibc_pool.py \
    && rm -f /tmp/build_glibc_pool.py
# 离线 OCR（Captcha / PoW 自动化）与 PHP Filter Chain 利用链生成工具。置于末尾以复用基础层缓存。
RUN (sed -i 's/mirrors.aliyun.com/mirrors.tuna.tsinghua.edu.cn/g; s/deb.debian.org/mirrors.tuna.tsinghua.edu.cn/g' /etc/apt/sources.list.d/debian.sources 2>/dev/null || true) \
    && apt-get -o Acquire::http::Timeout=300 -o Acquire::Retries=8 update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y -o Acquire::http::Timeout=300 -o Acquire::Retries=8 --fix-missing --no-install-recommends \
    tesseract-ocr tesseract-ocr-eng libgl1 libglib2.0-0 && rm -rf /var/lib/apt/lists/*
RUN /opt/ctf/pwn/bin/pip install --no-cache-dir -i https://pypi.tuna.tsinghua.edu.cn/simple \
    ddddocr pytesseract opencv-python-headless pillow \
    && /opt/ctf/pwn/bin/pip check \
    && /opt/ctf/pwn/bin/pip freeze > /opt/ctf/pwn-lock.txt
COPY docker/ctf-tools/php_filter_chain_generator.py /opt/tools/php_filter_chain_generator/php_filter_chain_generator.py
RUN chmod +x /opt/tools/php_filter_chain_generator/php_filter_chain_generator.py \
    && ln -sf /opt/tools/php_filter_chain_generator/php_filter_chain_generator.py /usr/local/bin/php_filter_chain_generator \
    && /opt/ctf/pwn/bin/python3 -c "import ddddocr, cv2, pytesseract; d = ddddocr.DdddOcr(show_ad=False); assert hasattr(d, 'classification')" \
    && /opt/ctf/pwn/bin/python3 /usr/local/bin/php_filter_chain_generator --chain '<?php echo 1; ?>' >/dev/null \
    && chmod -R a+rX /opt/ctf/pwn /opt/tools/php_filter_chain_generator
# 多阶段内网渗透与代理转发工具（与 Dockerfile.bench 保持一致）
RUN (sed -i 's/mirrors.tuna.tsinghua.edu.cn/mirrors.aliyun.com/g; s/deb.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list.d/debian.sources 2>/dev/null || true) \
    && apt-get -o Acquire::http::Timeout=60 -o Acquire::Retries=5 update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y -o Acquire::http::Timeout=60 -o Acquire::Retries=5 --no-install-recommends \
    openssh-client sshpass proxychains4 sleuthkit ewf-tools e2fsprogs sqlite3 && rm -rf /var/lib/apt/lists/*
# 高速 SAT 求解器（python-sat 内置 CaDiCaL / Glucose / MiniSat），同时装入 pwn 与 re 环境
RUN /opt/ctf/pwn/bin/pip install --no-cache-dir -i https://pypi.tuna.tsinghua.edu.cn/simple python-sat \
    && /opt/ctf/re/bin/pip install --no-cache-dir -i https://pypi.tuna.tsinghua.edu.cn/simple python-sat \
    && /opt/ctf/pwn/bin/python3 -c "from pysat.solvers import Cadical195" \
    && /opt/ctf/re/bin/python3 -c "from pysat.solvers import Cadical195" \
    && chmod -R a+rX /opt/ctf/pwn /opt/ctf/re
# 内网路由探测（iproute2）与 Flask Session 伪造/破解常用件（置于末尾复用基础层缓存）
RUN apt-get -o Acquire::http::Timeout=120 -o Acquire::Retries=5 update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y -o Acquire::http::Timeout=120 -o Acquire::Retries=5 --no-install-recommends iproute2 \
    && rm -rf /var/lib/apt/lists/* \
    && /opt/ctf/pwn/bin/pip install --no-cache-dir -i https://pypi.tuna.tsinghua.edu.cn/simple flask itsdangerous flask-unsign \
    && /opt/ctf/pwn/bin/python3 -c "import flask, itsdangerous; print('flask_ok')" \
    && chmod -R a+rX /opt/ctf/pwn
ENV PATH="/opt/ctf/pwn/bin:${PATH}" HOME=/work XDG_CACHE_HOME=/work/.cache XDG_CONFIG_HOME=/work/.config JAVA_TOOL_OPTIONS="-Duser.home=/work" PYTHONPYCACHEPREFIX=/tmp/pycache PWNLIB_NOTERM=1 TERM=dumb
RUN useradd --uid 1000 --create-home ctf && mkdir -p /work && chown 1000:1000 /work
USER 1000:1000
WORKDIR /work
CMD ["sleep", "infinity"]
